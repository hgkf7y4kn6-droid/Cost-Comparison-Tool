            rx.text(
                "Columns required: sku, name, description, category, tier (good/better/best), price",
                font_size="0.8em",
                color="gray",
            ),
            rx.upload(
                rx.vstack(
                    rx.button("Select Catalog File", color_scheme="blue", size="2"),
