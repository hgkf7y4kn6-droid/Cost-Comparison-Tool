                        is_external=True,
                        width="100%",
                    ),
                    width="100%",
                    custom_attrs={"aria-live": "polite"},
                ),
            ),
            align="center",
            spacing="3",
        ),
        padding="2em",
        max_width="700px",
    )


app = rx.App()
app.add_page(index)
