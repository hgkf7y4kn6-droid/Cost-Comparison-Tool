            rx.cond(
                InventoryState.catalog_error != "",
                rx.text(InventoryState.catalog_error, color="red", custom_attrs={"aria-live": "assertive"}),
            ),

            # --- Step 2: Upload competitor product ---
            rx.divider(margin_y="1em"),
            rx.text("2. Upload the current (competitor) product", font_weight="bold"),
            rx.text(
                "Photo, PDF, or Excel — price and product info are extracted automatically",
                font_size="0.8em",
                color="gray",
            ),
            rx.upload(
                rx.vstack(
                    rx.button("Select Product File", color_scheme="green", size="2"),
                    rx.text("Supports: .png, .jpg, .pdf, .xlsx", font_size="0.8em", color="gray"),
                ),
                id="compare_upload",
                border="2px dashed #CBD5E0",
                padding="1.5em",
                border_radius="10px",
                width="100%",
            ),
            rx.button(
                "Run Cost Comparison",
                on_click=InventoryState.handle_compare(
                    rx.upload_files(upload_id="compare_upload")
                ),
                is_loading=InventoryState.is_comparing,
                color_scheme="green",
                width="100%",
            ),
            rx.cond(
                InventoryState.compare_error != "",
                rx.text(InventoryState.compare_error, color="red", custom_attrs={"aria-live": "assertive"}),
            ),

            # --- Results ---
            rx.cond(
                InventoryState.competitor_product != "",
                rx.vstack(
                    rx.divider(margin_y="1em"),
                    rx.text(f"Current product: {InventoryState.competitor_product}", font_weight="bold"),
                    rx.text(f"Detected price: {InventoryState.competitor_price}"),
                    rx.text(f"Matched category: {InventoryState.matched_category}", color="gray"),
                    rx.badge(InventoryState.match_source, color_scheme="purple"),
                    rx.foreach(InventoryState.tiers, tier_card),
                    rx.cond(
                        InventoryState.manual_lookup_note != "",
                        rx.box(
                            rx.text(InventoryState.manual_lookup_note, font_size="0.85em"),
                            rx.link(
                                "Open supplies.officebasics.com",
                                href=InventoryState.manual_lookup_url,
