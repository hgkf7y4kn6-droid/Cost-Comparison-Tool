            rx.cond(
                InventoryState.spend_error != "",
                rx.text(InventoryState.spend_error, color="red", custom_attrs={"aria-live": "assertive"}),
            ),
            rx.cond(
                InventoryState.spend_workbook_url != "",
                rx.vstack(
                    rx.divider(margin_y="0.5em"),
                    rx.hstack(
                        rx.vstack(
                            rx.text("Current Spend", font_size="0.8em", color="gray"),
                            rx.text(InventoryState.spend_total_current, font_weight="bold"),
