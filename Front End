import reflex as rx
import requests

API_BASE = "http://localhost:8000"
OFFICEBASICS_PORTAL_URL = "https://supplies.officebasics.com/"


def _error_detail(response: requests.Response, fallback: str) -> str:
    """Shared error-message extraction used by every upload handler below."""
    try:
        return response.json().get("detail", fallback)
    except ValueError:
        return fallback


class InventoryState(rx.State):
    # catalog upload
    catalog_status: str = ""
    catalog_loaded_count: int = 0
    catalog_error: str = ""
    is_uploading_catalog: bool = False

    # comparison
    is_comparing: bool = False
    compare_error: str = ""
    comparison_id: str = ""
    competitor_product: str = ""
    competitor_price: str = ""
    matched_category: str = ""
    match_source: str = ""
    tiers: list[dict] = []
    download_url: str = ""
    manual_lookup_note: str = ""
    manual_lookup_url: str = ""

    # feedback / confirmation
    good_sku_override: str = ""
    better_sku_override: str = ""
    best_sku_override: str = ""
    is_confirming: bool = False
    confirm_status: str = ""

    # spend analysis
    is_analyzing_spend: bool = False
    spend_error: str = ""
    spend_total_current: str = ""
    spend_total_recommended: str = ""
    spend_total_savings: str = ""
    spend_savings_pct: str = ""
    spend_rows_analyzed: str = ""
    spend_rows_unmatched: str = ""
    spend_workbook_url: str = ""
    spend_summary_url: str = ""
    spend_manual_lookup_note: str = ""

    async def handle_catalog_upload(self, files: list[rx.UploadFile]):
        if not files:
            return
        self.is_uploading_catalog = True
        self.catalog_error = ""
        upload_file = files[0]
        file_bytes = await upload_file.read()

        try:
            response = requests.post(
                f"{API_BASE}/catalog/upload/",
                files={"file": (upload_file.filename, file_bytes, upload_file.content_type)},
            )
            if response.status_code == 200:
                data = response.json()
                self.catalog_loaded_count = data.get("loaded_items", 0)
                self.catalog_status = (
                    f"Loaded {self.catalog_loaded_count} SKUs across "
                    f"{len(data.get('categories', []))} categories."
                )
            else:
                self.catalog_error = _error_detail(response, "Failed to load catalog")
        except Exception as e:
            self.catalog_error = f"Connection failed: {str(e)}"
        finally:
            self.is_uploading_catalog = False

    async def handle_compare(self, files: list[rx.UploadFile]):
        if not files:
            return
        self.is_comparing = True
        self.compare_error = ""
        self.download_url = ""
        upload_file = files[0]
        file_bytes = await upload_file.read()

        try:
            response = requests.post(
                f"{API_BASE}/compare/download/",
                files={"file": (upload_file.filename, file_bytes, upload_file.content_type)},
            )
            if response.status_code == 200:
                data = response.json()
                comparison = data["comparison"]
                self.comparison_id = comparison.get("comparison_id", "")
                self.competitor_product = comparison.get("competitor_product", "")
                price = comparison.get("competitor_price")
                self.competitor_price = f"${price:,.2f}" if price else "Not detected"
                self.matched_category = comparison.get("matched_category", "") or ""
                self.match_source = (
                    "Learned from a confirmed match"
                    if comparison.get("source") == "learned"
                    else "Algorithmic match"
                )

                tier_rows = []
                for tier_name in ["good", "better", "best"]:
                    item = comparison.get("tiers", {}).get(tier_name)
                    if item:
                        tier_rows.append(
                            {
                                "tier": tier_name.upper(),
                                "name": item["name"],
                                "sku": item["sku"],
                                "price": f"${item['price']:,.2f}",
                            }
                        )
                self.tiers = tier_rows
                self.download_url = f"{API_BASE}{data['download_url']}"
                self.confirm_status = ""

                manual_lookup = comparison.get("manual_lookup")
                self.manual_lookup_note = manual_lookup["note"] if manual_lookup else ""
                self.manual_lookup_url = manual_lookup["portal_url"] if manual_lookup else ""
            else:
                self.compare_error = _error_detail(response, "Comparison failed")
        except Exception as e:
            self.compare_error = f"Connection failed: {str(e)}"
        finally:
            self.is_comparing = False

    async def handle_confirm(self):
        if not self.comparison_id:
            return
        self.is_confirming = True
        self.confirm_status = ""
        payload = {"comparison_id": self.comparison_id}
        if self.good_sku_override.strip():
            payload["good_sku"] = self.good_sku_override.strip()
        if self.better_sku_override.strip():
            payload["better_sku"] = self.better_sku_override.strip()
        if self.best_sku_override.strip():
            payload["best_sku"] = self.best_sku_override.strip()

        try:
            response = requests.post(f"{API_BASE}/feedback/confirm/", json=payload)
            if response.status_code == 200:
                self.confirm_status = "Saved — future similar products will use this match."
            else:
                self.confirm_status = _error_detail(response, "Could not save feedback")
        except Exception as e:
            self.confirm_status = f"Connection failed: {str(e)}"
        finally:
            self.is_confirming = False

    async def handle_spend_analysis(self, files: list[rx.UploadFile]):
        if not files:
            return
        self.is_analyzing_spend = True
        self.spend_error = ""
        upload_file = files[0]
        file_bytes = await upload_file.read()

        try:
            response = requests.post(
                f"{API_BASE}/analysis/spend/",
                files={"file": (upload_file.filename, file_bytes, upload_file.content_type)},
                data={"recommended_tier": "best"},
            )
            if response.status_code == 200:
                data = response.json()
                summary = data["summary"]
                self.spend_total_current = f"${summary['total_current_spend']:,.2f}"
                self.spend_total_recommended = f"${summary['total_recommended_spend']:,.2f}"
                self.spend_total_savings = f"${summary['total_savings']:,.2f}"
                self.spend_savings_pct = f"{summary['savings_pct']:.1f}%"
                self.spend_rows_analyzed = str(summary["rows_analyzed"])
                self.spend_rows_unmatched = str(summary["rows_unmatched"])
                self.spend_workbook_url = f"{API_BASE}{data['workbook_url']}"
                self.spend_summary_url = f"{API_BASE}{data['executive_summary_url']}"
                self.spend_manual_lookup_note = summary.get("manual_lookup_note") or ""
            else:
                self.spend_error = _error_detail(response, "Spend analysis failed")
        except Exception as e:
            self.spend_error = f"Connection failed: {str(e)}"
        finally:
            self.is_analyzing_spend = False


def tier_card(item: dict) -> rx.Component:
    return rx.box(
        rx.hstack(
            rx.badge(item["tier"], color_scheme="blue"),
            rx.vstack(
                rx.text(item["name"], font_weight="bold"),
                rx.text(f"SKU: {item['sku']}", font_size="0.85em", color="gray"),
                align_items="start",
                spacing="0",
            ),
            rx.spacer(),
            rx.text(item["price"], font_weight="bold", font_size="1.1em"),
            width="100%",
        ),
        border="1px solid #E2E8F0",
        border_radius="8px",
        padding="0.8em",
        margin_y="0.4em",
        width="100%",
    )


