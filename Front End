                                font_size="0.85em",
                            ),
                            border="1px solid #F0C36D",
                            background="#FFF8E6",
                            border_radius="8px",
                            padding="0.6em",
                            width="100%",
                        ),
                    ),
                    rx.cond(
                        InventoryState.download_url != "",
                        rx.link(
                            rx.button("Download Cost Comparison (.xlsx)", color_scheme="blue"),
                            href=InventoryState.download_url,
                            is_external=True,
