# Copy to .env for local runs (`npx expo start`). All values are public,
# client-side keys; never put secret keys here.
#
# Production builds get these from:
#   - web (Cloudflare): Worker -> Settings -> Build -> Variables and secrets
#   - iOS/Android (EAS): `npx eas-cli@latest env:set` (or expo.dev -> project -> Environment variables)

# Backend on Render
EXPO_PUBLIC_API_BASE=https://cost-comparison-tool.onrender.com

# Clerk dashboard -> API keys -> Publishable key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# PostHog -> Project settings -> Project API key (leave blank to disable analytics)
EXPO_PUBLIC_POSTHOG_KEY=phc_...
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
